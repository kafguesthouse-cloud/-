rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMenuCodeId(codeId) {
      return codeId is string && codeId.matches('^([1-9][0-9]{0,2}|1000)$');
    }

    function isValidPin(pin) {
      return pin is string && pin.size() >= 4 && pin.size() <= 8 && pin.matches('^[0-9]{4,8}$');
    }

    function isValidCafeConfig(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidPin(data.cashierPin) &&
             isValidPin(data.ticketerPin) &&
             data.pinsCustomized is bool &&
             data.alias78To79 is bool &&
             data.staff is list && data.staff.size() <= 50 &&
             (data.staff.size() == 0 || (data.staff[0] is string && data.staff[0].size() >= 1 && data.staff[0].size() <= 50)) &&
             data.nextTicketSeq is int && data.nextTicketSeq >= 1 && data.nextTicketSeq <= 1000000 &&
             data.lastTicketDay is string && data.lastTicketDay.size() == 10 &&
             data.lastTicketDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('dayEpoch' in data) || (data.dayEpoch is int && data.dayEpoch >= 1 && data.dayEpoch <= 1000000)) &&
             (!('linkedEmail' in data) || (data.linkedEmail is string && data.linkedEmail.size() <= 120)) &&
             (!('appPasswordHash' in data) || (data.appPasswordHash is string && data.appPasswordHash.size() <= 128)) &&
             (!('appPasswordSalt' in data) || (data.appPasswordSalt is string && data.appPasswordSalt.size() <= 64)) &&
             (!('appPasswordSet' in data) || data.appPasswordSet is bool);
    }

    function isValidMenuItem(data, codeId) {
      return data.code is int && data.code >= 1 && data.code <= 1000 &&
             string(data.code) == codeId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.price is number && data.price >= 0 && data.price <= 1000000;
    }

    function isValidOrder(data) {
      return data.ticketNumber is int && data.ticketNumber >= 1 && data.ticketNumber <= 1000000 &&
             data.dayKey is string && data.dayKey.size() == 10 &&
             data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             (!('dayEpoch' in data) || (data.dayEpoch is int && data.dayEpoch >= 1 && data.dayEpoch <= 1000000)) &&
             data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 50 &&
             data.status in ['PENDING', 'COMPLETED', 'RETURNED'] &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 50 &&
             data.items[0] is map &&
             data.items[0].c is int && data.items[0].c >= 1 && data.items[0].c <= 1000 &&
             data.items[0].n is string && data.items[0].n.size() >= 1 && data.items[0].n.size() <= 60 &&
             data.items[0].q is int && data.items[0].q >= 1 && data.items[0].q <= 999 &&
             data.items[0].p is number && data.items[0].p >= 0 && data.items[0].p <= 1000000 &&
             data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 10000000 &&
             data.unpaid is bool &&
             (!('urgent' in data) || data.urgent is bool) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 15));
    }

    match /users/{userId} {

      // Workspace Settings (/users/{userId}/config/settings)
      match /config/{configId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         configId == 'settings' &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll([
                           'userId', 'cashierPin', 'ticketerPin', 'pinsCustomized',
                           'alias78To79', 'staff', 'nextTicketSeq', 'lastTicketDay',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'cashierPin', 'ticketerPin', 'pinsCustomized',
                           'alias78To79', 'staff', 'nextTicketSeq', 'lastTicketDay', 'dayEpoch',
                           'linkedEmail', 'appPasswordHash', 'appPasswordSalt', 'appPasswordSet',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidCafeConfig(incoming());

        allow update: if isOwner(userId) &&
                         configId == 'settings' &&
                         isValidCafeConfig(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         (
                           // Action: Advance daily ticket sequence or start a new day/shift epoch
                           incoming().diff(existing()).affectedKeys().hasOnly(['nextTicketSeq', 'lastTicketDay', 'dayEpoch', 'updatedAt']) ||
                           // Action: Update settings (PINs, alias rule, staff list)
                           incoming().diff(existing()).affectedKeys().hasOnly(['cashierPin', 'ticketerPin', 'pinsCustomized', 'alias78To79', 'staff', 'updatedAt']) ||
                           // Action: Create, update, or reset workspace App Password
                           incoming().diff(existing()).affectedKeys().hasOnly(['linkedEmail', 'appPasswordHash', 'appPasswordSalt', 'appPasswordSet', 'updatedAt'])
                         );

        allow delete: if false;
      }

      // Menu Items 1..1000 (/users/{userId}/menuItems/{codeId})
      match /menuItems/{codeId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidMenuCodeId(codeId);

        allow create: if isOwner(userId) &&
                         isValidMenuCodeId(codeId) &&
                         incoming().keys().hasAll(['code', 'name', 'price', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['code', 'name', 'price', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidMenuItem(incoming(), codeId);

        allow update: if isOwner(userId) &&
                         isValidMenuCodeId(codeId) &&
                         isValidMenuItem(incoming(), codeId) &&
                         incoming().code == existing().code &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'price', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidMenuCodeId(codeId);
      }

      // Real-time Cafe Orders (/users/{userId}/orders/{orderId})
      match /orders/{orderId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(orderId);

        allow create: if isOwner(userId) &&
                         isValidId(orderId) &&
                         incoming().keys().hasAll([
                           'ticketNumber', 'dayKey', 'staffName', 'status',
                           'items', 'totalAmount', 'unpaid', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'ticketNumber', 'dayKey', 'dayEpoch', 'staffName', 'status',
                           'items', 'totalAmount', 'unpaid', 'urgent', 'note',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().status == 'PENDING' &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidOrder(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(orderId) &&
                         isValidOrder(incoming()) &&
                         incoming().ticketNumber == existing().ticketNumber &&
                         incoming().dayKey == existing().dayKey &&
                         incoming().staffName == existing().staffName &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         existing().status != 'RETURNED' &&
                         (
                           // Action: Cashier edits items/quantities/note/urgent on unserved PENDING ticket
                           (
                             existing().status == 'PENDING' &&
                             incoming().status == 'PENDING' &&
                             incoming().unpaid == existing().unpaid &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['items', 'totalAmount', 'note', 'urgent', 'updatedAt'])
                           ) ||
                           // Action: Ticketer marks order completed ("ወጥቷል")
                           (
                             existing().status == 'PENDING' &&
                             incoming().status == 'COMPLETED' &&
                             incoming().items == existing().items &&
                             incoming().totalAmount == existing().totalAmount &&
                             incoming().completedAt is timestamp && incoming().completedAt <= request.time &&
                             incoming().unpaid == existing().unpaid &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])
                           ) ||
                           // Action: Ticketer marks order returned ("ተመልሷል" / "የተመለሰ")
                           (
                             (existing().status == 'PENDING' || existing().status == 'COMPLETED') &&
                             incoming().status == 'RETURNED' &&
                             incoming().items == existing().items &&
                             incoming().totalAmount == existing().totalAmount &&
                             incoming().completedAt is timestamp && incoming().completedAt <= request.time &&
                             incoming().unpaid == existing().unpaid &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt', 'note'])
                           ) ||
                           // Action: Cashier marks unpaid order as paid ("ተከፍሏል")
                           (
                             existing().unpaid == true &&
                             incoming().unpaid == false &&
                             incoming().status == existing().status &&
                             incoming().items == existing().items &&
                             incoming().totalAmount == existing().totalAmount &&
                             incoming().paidAt is timestamp && incoming().paidAt <= request.time &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['unpaid', 'paidAt', 'updatedAt'])
                           )
                         );

        // Cashier can cancel/delete orders ONLY while unserved (PENDING)
        allow delete: if isOwner(userId) &&
                         isValidId(orderId) &&
                         existing().status == 'PENDING';
      }
    }
  }
}
